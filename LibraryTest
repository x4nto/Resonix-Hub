local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Library = {}

function Library:CreateWindow(title, assetId)
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ResonixHub"
    screenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0.5, 0, 0.5, 0)
    frame.Position = UDim2.new(0.25, 0, 0.25, 0)
    frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    frame.Parent = screenGui

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, 0, 0.1, 0)
    titleLabel.Text = title
    titleLabel.Parent = frame

    local minimizeButton = Instance.new("TextButton")
    minimizeButton.Size = UDim2.new(0.05, 0, 0.1, 0)
    minimizeButton.Position = UDim2.new(0.85, 0, 0, 0)
    minimizeButton.Text = "-"
    minimizeButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    minimizeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    minimizeButton.Parent = frame

    local closeButton = Instance.new("TextButton")
    closeButton.Size = UDim2.new(0.05, 0, 0.1, 0)
    closeButton.Position = UDim2.new(0.9, 0, 0, 0)
    closeButton.Text = "X"
    closeButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeButton.Parent = frame

    local minimizeIcon = Instance.new("ImageButton")
    local UICorner = Instance.new("UICorner")
    
    minimizeIcon.Name = "minimizeIcon"
    minimizeIcon.Parent = screenGui
    minimizeIcon.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    minimizeIcon.BorderColor3 = Color3.fromRGB(0, 0, 0)
    minimizeIcon.BorderSizePixel = 0
    minimizeIcon.Position = UDim2.new(0.201, 0, 0.204, 0)
    minimizeIcon.Size = UDim2.new(0, 32, 0, 31)
    minimizeIcon.Image = "http://www.roblox.com/asset/?id=112326644084843"
    minimizeIcon.Visible = false
    
    UICorner.Parent = minimizeIcon

    minimizeButton.MouseButton1Click:Connect(function()
        frame:TweenSize(UDim2.new(0.5, 0, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.5, true)
        wait(0.5)
        frame.Visible = false
        minimizeIcon.Visible = true
    end)

    minimizeIcon.MouseButton1Click:Connect(function()
        frame.Visible = true
        frame:TweenSize(UDim2.new(0.5, 0, 0.5, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.5, true)
        minimizeIcon.Visible = false
    end)

    closeButton.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)

    local scrollingFrame = Instance.new("ScrollingFrame")
    scrollingFrame.Size = UDim2.new(1, 0, 0.9, 0)
    scrollingFrame.Position = UDim2.new(0, 0, 0.1, 0)
    scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    scrollingFrame.Parent = frame
    scrollingFrame.BackgroundTransparency = 1
    scrollingFrame.ScrollBarThickness = 5

    local layout = Instance.new("UIListLayout")
    layout.Parent = scrollingFrame
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    self.Frame = frame
    self.ScrollingFrame = scrollingFrame
end

function Library:CreateTab(tabName)
    local tabButton = Instance.new("TextButton")
    tabButton.Size = UDim2.new(1, 0, 0.1, 0)
    tabButton.Text = tabName
    tabButton.Parent = self.ScrollingFrame

    local tabContainer = Instance.new("Frame")
    tabContainer.Name = tabName .. "Container"
    tabContainer.Size = UDim2.new(1, 0, 0, 50)
    tabContainer.Visible = false
    tabContainer.Parent = self.ScrollingFrame

    local layout = Instance.new("UIListLayout")
    layout.Parent = self.ScrollingFrame
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    tabButton.MouseButton1Click:Connect(function()
        for _, child in pairs(self.ScrollingFrame:GetChildren()) do
            if child:IsA("Frame") and child.Name ~= tabContainer.Name then
                child.Visible = false
            end
        end
        tabContainer.Visible = true
    end)

    self.ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, self.ScrollingFrame.UIListLayout.AbsoluteContentSize.Y)

    return tabContainer
end

function Library:CreateButton(tabContainer, buttonName, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0.1, 0)
    button.Text = buttonName
    button.Parent = tabContainer

    button.MouseButton1Click:Connect(callback)
end

return Library
