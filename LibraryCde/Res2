local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Library = {}

function Library:CreateWindow(title, assetId)
    -- Create the main ScreenGui
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ResonixHub"
    screenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    -- Create the main window frame
    local ResonixWindow = Instance.new("Frame")
    ResonixWindow.Name = "ResonixWindow"
    ResonixWindow.Parent = screenGui
    ResonixWindow.BackgroundColor3 = Color3.fromRGB(36, 16, 16)
    ResonixWindow.BorderSizePixel = 0
    ResonixWindow.Position = UDim2.new(0.336, 0, 0.326, 0)
    ResonixWindow.Size = UDim2.new(0, 361, 0, 216)

    -- Make the window draggable
    ResonixWindow.Draggable = true
    ResonixWindow.Active = true
    ResonixWindow.Selectable = true

    -- Create the top bar
    local TopWindow = Instance.new("Frame")
    TopWindow.Name = "TopWindow"
    TopWindow.Parent = ResonixWindow
    TopWindow.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
    TopWindow.BorderSizePixel = 0
    TopWindow.Size = UDim2.new(1, 0, 0, 34)

    -- Add the title label
    local TextLabel = Instance.new("TextLabel")
    TextLabel.Parent = TopWindow
    TextLabel.BackgroundTransparency = 1
    TextLabel.Position = UDim2.new(0.1, 0, 0.05, 0)
    TextLabel.Size = UDim2.new(0, 96, 0, 30)
    TextLabel.Font = Enum.Font.ArialBold
    TextLabel.Text = title
    TextLabel.TextColor3 = Color3.fromRGB(255, 0, 4)
    TextLabel.TextSize = 14

    -- Add the icon
    local ImageLabel = Instance.new("ImageLabel")
    ImageLabel.Parent = TopWindow
    ImageLabel.BackgroundTransparency = 1
    ImageLabel.Position = UDim2.new(0.017, 0, 0, 0)
    ImageLabel.Size = UDim2.new(0, 31, 0, 31)
    ImageLabel.Image = "rbxassetid://132356790048396" -- Replace with your asset ID

    -- Add a thin line below the top bar
    local TopLine = Instance.new("Frame")
    TopLine.Name = "TopLine"
    TopLine.Parent = ResonixWindow
    TopLine.BackgroundColor3 = Color3.fromRGB(115, 0, 2)
    TopLine.BorderSizePixel = 0
    TopLine.Position = UDim2.new(0, 0, 0.157, 0)
    TopLine.Size = UDim2.new(1, 0, 0, 1)

    -- Create the tab frame
    local TabFrame = Instance.new("Frame")
    TabFrame.Name = "TabFrame"
    TabFrame.Parent = ResonixWindow
    TabFrame.BackgroundColor3 = Color3.fromRGB(36, 16, 16)
    TabFrame.BorderSizePixel = 0
    TabFrame.Position = UDim2.new(0, 0, 0.157, 0)
    TabFrame.Size = UDim2.new(0, 132, 0, 182)

    -- Add a thin line between the tabs and the object frame
    local TabLine = Instance.new("Frame")
    TabLine.Name = "TabLine"
    TabLine.Parent = ResonixWindow
    TabLine.BackgroundColor3 = Color3.fromRGB(115, 0, 2)
    TabLine.BorderSizePixel = 0
    TabLine.Position = UDim2.new(0.365, 0, 0.157, 0)
    TabLine.Size = UDim2.new(0, 1, 0, 182)

    -- Add a scrolling frame for tabs
    local ScrollingFrame = Instance.new("ScrollingFrame")
    ScrollingFrame.Parent = TabFrame
    ScrollingFrame.BackgroundTransparency = 1
    ScrollingFrame.BorderSizePixel = 0
    ScrollingFrame.Position = UDim2.new(0.015, 0, 0.011, 0)
    ScrollingFrame.Size = UDim2.new(0, 123, 0, 174)
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, 0)

    -- Add a UIListLayout to the scrolling frame
    local layout = Instance.new("UIListLayout")
    layout.Parent = ScrollingFrame
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 5)

    -- Create the content frame
    local AllFrame = Instance.new("Frame")
    AllFrame.Name = "AllFrame"
    AllFrame.Parent = ResonixWindow
    AllFrame.BackgroundColor3 = Color3.fromRGB(36, 16, 16)
    AllFrame.BorderSizePixel = 0
    AllFrame.Position = UDim2.new(0.365, 0, 0.157, 0)
    AllFrame.Size = UDim2.new(0, 230, 0, 182)

    -- Create the minimize icon (hidden by default)
    local minimizeIcon = Instance.new("ImageButton")
    minimizeIcon.Name = "minimizeIcon"
    minimizeIcon.Parent = screenGui
    minimizeIcon.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
    minimizeIcon.BorderSizePixel = 0
    minimizeIcon.Position = UDim2.new(0.201, 0, 0.204, 0)
    minimizeIcon.Size = UDim2.new(0, 32, 0, 31)
    minimizeIcon.Image = "rbxassetid://132356790048396" -- Replace with your asset ID
    minimizeIcon.Visible = false

    -- Make the minimize icon draggable
    minimizeIcon.Draggable = true
    minimizeIcon.Active = true
    minimizeIcon.Selectable = true

    -- Minimize button functionality
    local minimizeButton = Instance.new("TextButton")
    minimizeButton.Parent = TopWindow
    minimizeButton.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
    minimizeButton.BorderSizePixel = 0
    minimizeButton.Position = UDim2.new(0.85, 0, 0, 0)
    minimizeButton.Size = UDim2.new(0, 34, 0, 34)
    minimizeButton.Text = "-"
    minimizeButton.TextColor3 = Color3.fromRGB(255, 0, 4)
    minimizeButton.TextSize = 14

    minimizeButton.MouseButton1Click:Connect(function()
        -- Shrink the UI smoothly
        local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = game:GetService("TweenService"):Create(ResonixWindow, tweenInfo, {Size = UDim2.new(0, 0, 0, 0)})
        tween:Play()
        tween.Completed:Wait()
        ResonixWindow.Visible = false
        minimizeIcon.Visible = true
    end)

    -- Minimize icon functionality
    minimizeIcon.MouseButton1Click:Connect(function()
        ResonixWindow.Visible = true
        -- Restore the UI smoothly
        local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = game:GetService("TweenService"):Create(ResonixWindow, tweenInfo, {Size = UDim2.new(0, 361, 0, 216)})
        tween:Play()
        minimizeIcon.Visible = false
    end)

    -- Close button functionality
    local closeButton = Instance.new("TextButton")
    closeButton.Parent = TopWindow
    closeButton.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
    closeButton.BorderSizePixel = 0
    closeButton.Position = UDim2.new(0.90, 0, 0, 0)
    closeButton.Size = UDim2.new(0, 10, 0, 34) -- Made bigger
    closeButton.Font = Enum.Font.GothamBold
    closeButton.Text = "X"
    closeButton.TextColor3 = Color3.fromRGB(255, 0, 4)
    closeButton.TextSize = 12

    closeButton.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)

    -- Store references to the window and frames
    self.ResonixWindow = ResonixWindow
    self.ScrollingFrame = ScrollingFrame
    self.AllFrame = AllFrame
end

function Library:CreateTab(tabName)
    -- Create the tab button
    local tabButton = Instance.new("TextButton")
    tabButton.Parent = self.ScrollingFrame
    tabButton.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
    tabButton.BorderSizePixel = 2
    tabButton.BorderColor3 = Color3.fromRGB(94, 0, 2)
    tabButton.Size = UDim2.new(0, 104, 0, 23)
    tabButton.Font = Enum.Font.ArialBold
    tabButton.Text = tabName
    tabButton.TextColor3 = Color3.fromRGB(255, 0, 4)
    tabButton.TextSize = 14

    -- Add a UICorner to the tab button
    local UICorner = Instance.new("UICorner")
    UICorner.Parent = tabButton

    -- Create the tab container
    local tabContainer = Instance.new("Frame")
    tabContainer.Name = tabName .. "Container"
    tabContainer.Parent = self.AllFrame
    tabContainer.BackgroundColor3 = Color3.fromRGB(36, 16, 16)
    tabContainer.BorderSizePixel = 0
    tabContainer.Size = UDim2.new(1, 0, 1, 0)
    tabContainer.Visible = false

    -- Add a UIListLayout to the tab container
    local layout = Instance.new("UIListLayout")
    layout.Parent = tabContainer
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 5)

    -- Tab button click functionality
    tabButton.MouseButton1Click:Connect(function()
        for _, child in pairs(self.AllFrame:GetChildren()) do
            if child:IsA("Frame") and child.Name ~= tabContainer.Name then
                child.Visible = false
            end
        end
        tabContainer.Visible = true
    end)

    -- Update the scrolling frame's canvas size
    self.ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, self.ScrollingFrame.UIListLayout.AbsoluteContentSize.Y)

    return tabContainer
end

function Library:CreateButton(tabContainer, buttonName, callback)
    -- Create the button
    local button = Instance.new("TextButton")
    button.Parent = tabContainer
    button.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
    button.BorderSizePixel = 0
    button.Size = UDim2.new(1, 0, 0, 28)
    button.Position = UDim2.new(0, -5, 0, 5)
    button.Font = Enum.Font.ArialBold
    button.Text = buttonName
    button.TextColor3 = Color3.fromRGB(255, 0, 4)
    button.TextSize = 14

    -- Add a UICorner to the button
    local UICorner = Instance.new("UICorner")
    UICorner.Parent = button

    -- Move the button slightly down to align with the first

    -- Connect the button's click event to the callback
    button.MouseButton1Click:Connect(callback)
end

return Library
