				local touchDuration = tick() - touchStartTime
				local endPos = input.Position
				local movement = touchStartPos and (endPos - touchStartPos).magnitude or 0

				if not isScrolling and touchDuration <= maxTapDuration and movement <= maxTapMovement then
					action()
