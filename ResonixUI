function Library:Destroy()
	-- Check if the window exists
	if self.ResonixWindow and self.ResonixWindow.Parent then
		-- Get the ScreenGui parent
		local screenGui = self.ResonixWindow.Parent

		-- Animation settings
		local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

		-- Animate the window moving downward and fading out
		local windowTween = game:GetService("TweenService"):Create(self.ResonixWindow, tweenInfo, {
			Position = UDim2.new(self.ResonixWindow.Position.X.Scale, self.ResonixWindow.Position.X.Offset, 1.5, 0),
			BackgroundTransparency = 1
		})
		windowTween:Play()

		-- Also animate the minimize icon if it exists
		local minimizeIcon = screenGui:FindFirstChild("minimizeIcon")
		if minimizeIcon then
			local iconTween = game:GetService("TweenService"):Create(minimizeIcon, tweenInfo, {
				BackgroundTransparency = 1
			})
			iconTween:Play()
		end

		-- Wait for the animation to complete
		windowTween.Completed:Wait()

		-- Destroy the ScreenGui after the animation
		screenGui:Destroy()

		-- Clear references
		self.ResonixWindow = nil
		self.ScrollingFrame = nil
		self.AllFrame = nil
	end
end

return Library
