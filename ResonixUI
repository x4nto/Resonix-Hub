		if input.UserInputType == Enum.UserInputType.Touch and touchStartPos then
			local currentPos = input.Position
			local movement = (currentPos - touchStartPos).magnitude
			if movement > maxTapMovement then
				isScrolling = true
				setPressedState(button, false)
				setPressedState(viewButton, false)
			end
		end
	end)

	-- Set up button actions
	handleButtonPress(viewButton, toggleImageViewer)
	handleButtonPress(button, function()
		if callback then callback() end
	end)
	handleButtonPress(closeButton, toggleImageViewer)

