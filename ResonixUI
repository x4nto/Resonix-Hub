	switchButton.BorderSizePixel = 0
	switchButton.Size = UDim2.new(0, 14, 0, 14)
	switchButton.Position = UDim2.new(0, 1, 0.5, -7)
	switchButton.AnchorPoint = Vector2.new(0, -4)

	-- Add a UICorner to the switch button
	local switchButtonCorner = Instance.new("UICorner")
	switchButtonCorner.Parent = switchButton
	switchButtonCorner.CornerRadius = UDim.new(1, 0)

	-- Set the initial state of the toggle
	local isToggled = defaultState or false

	-- Function to update the toggle state with animation
	local function updateToggleState()
		local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tween = game:GetService("TweenService"):Create(
			switchButton,
			tweenInfo,
			{
				Position = isToggled and UDim2.new(1, -15, 0.5, -7) or UDim2.new(0, 1, 0.5, -7)
			}
		)
		tween:Play()

		local colorTween = game:GetService("TweenService"):Create(
			switchTrack,
			tweenInfo,
			{
				BackgroundColor3 = isToggled and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(64, 64, 64)
			}
		)
		colorTween:Play()
	end

	-- Set the initial state
	updateToggleState()

	-- Mobile-specific touch handling
	local touchStartPosition = nil
	local touchStartTime = 0
	local maxTapDuration = 0.3 -- Maximum time for a tap (seconds)
	local maxTapMovement = 10 -- Maximum movement allowed for a tap (pixels)

	-- Handle both mobile and PC input
	toggleFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			-- Mobile touch handling
			touchStartPosition = input.Position
			touchStartTime = tick()
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			-- PC mouse click handling - toggle immediately
			isToggled = not isToggled
			updateToggleState()
			callback(isToggled)
		end
	end)

	toggleFrame.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch and touchStartPosition then
			local touchEndPosition = input.Position
			local touchDuration = tick() - touchStartTime
			local movement = (touchEndPosition - touchStartPosition).magnitude

			-- Only register as a tap if it was quick and didn't move much
			if touchDuration <= maxTapDuration and movement <= maxTapMovement then
				isToggled = not isToggled
				updateToggleState()
				callback(isToggled)
			end

			touchStartPosition = nil
		end
	end)

	-- Add description if provided
	if description then
		local descLabel = Instance.new("TextLabel")
		descLabel.Parent = tabContainer
		descLabel.BackgroundTransparency = 1
		descLabel.Size = UDim2.new(1, 0, 0, 15)
		descLabel.Position = UDim2.new(0, 5, 0, 30)
		descLabel.Font = Enum.Font.Gotham
		descLabel.Text = description
		descLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		descLabel.TextSize = 12
		descLabel.TextXAlignment = Enum.TextXAlignment.Left
	end
end

function Library:CreateSlider(tabContainer, sliderName, minValue, maxValue, defaultValue, callback, description)
	-- Create the slider frame
	local sliderFrame = Instance.new("Frame")
	sliderFrame.Parent = tabContainer
	sliderFrame.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
	sliderFrame.BorderSizePixel = 0
	sliderFrame.Size = UDim2.new(1, 0, 0, 40)
	sliderFrame.Name = "SliderFrame"

	-- Add a UICorner to the slider frame
	local UICorner = Instance.new("UICorner")
	UICorner.Parent = sliderFrame

	-- Create the slider label
	local sliderLabel = Instance.new("TextLabel")
	sliderLabel.Parent = sliderFrame
	sliderLabel.BackgroundTransparency = 1
	sliderLabel.Size = UDim2.new(0.3, 0, 0.5, 0)
	sliderLabel.Position = UDim2.new(0, 5, 0, 0)
	sliderLabel.Font = Enum.Font.GothamBold
	sliderLabel.Text = sliderName
	sliderLabel.TextColor3 = Color3.fromRGB(255, 0, 4)
	sliderLabel.TextSize = 14
	sliderLabel.TextXAlignment = Enum.TextXAlignment.Left

	-- Create the slider track (now just visual, not interactive)
	local sliderTrack = Instance.new("Frame")
	sliderTrack.Parent = sliderFrame
	sliderTrack.BackgroundColor3 = Color3.fromRGB(64, 64, 64)
	sliderTrack.BorderSizePixel = 0
	sliderTrack.Size = UDim2.new(1, -10, 0, 6)
	sliderTrack.Position = UDim2.new(0.02, 0, 0.7, 0)
	sliderTrack.AnchorPoint = Vector2.new(0, 0.5)
	sliderTrack.Name = "SliderTrack"

	-- Add a UICorner to the slider track
	local sliderTrackCorner = Instance.new("UICorner")
	sliderTrackCorner.Parent = sliderTrack
	sliderTrackCorner.CornerRadius = UDim.new(1, 0)

	-- Create the fill frame
	local fillFrame = Instance.new("Frame")
	fillFrame.Parent = sliderTrack
	fillFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 4)
	fillFrame.BorderSizePixel = 0
	fillFrame.Size = UDim2.new(0, 0, 1, 0)
	fillFrame.AnchorPoint = Vector2.new(0, 0)

	-- Add a UICorner to the fill frame
	local fillCorner = Instance.new("UICorner")
	fillCorner.Parent = fillFrame
	fillCorner.CornerRadius = UDim.new(1, 0)

	-- Create the value label
	local valueLabel = Instance.new("TextLabel")
	valueLabel.Parent = sliderFrame
	valueLabel.BackgroundTransparency = 1
	valueLabel.Size = UDim2.new(0.1, 0, 0.5, 0)
	valueLabel.Position = UDim2.new(0.85, 0, 0, 0)
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.Text = tostring(defaultValue)
	valueLabel.TextColor3 = Color3.fromRGB(255, 0, 4)
	valueLabel.TextSize = 14
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right

	-- Initialize the slider value
	local value = math.clamp(defaultValue or minValue, minValue, maxValue)
	local function updateSlider()
		local percent = (value - minValue) / (maxValue - minValue)
		fillFrame.Size = UDim2.new(percent, 0, 1, 0)
		valueLabel.Text = tostring(math.floor(value))
	end

	-- Set the initial value
	updateSlider()

	-- Touch handling variables
	local isDragging = false
	local touchStartPosition = nil
	local touchStartTime = 0
	local originalScrollBarThickness = tabContainer.ScrollBarThickness

	-- Make the entire slider frame interactive
	sliderFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or 
			input.UserInputType == Enum.UserInputType.MouseButton1 then

			-- Store initial touch information
			touchStartPosition = input.Position
			touchStartTime = tick()

			-- Disable container scrolling while adjusting slider
			tabContainer.ScrollingEnabled = false
			tabContainer.ScrollBarThickness = 0

			-- Calculate initial value based on touch position
			local mousePosition = input.Position.X
			local trackPosition = sliderTrack.AbsolutePosition.X
			local trackSize = sliderTrack.AbsoluteSize.X
			local percent = math.clamp((mousePosition - trackPosition) / trackSize, 0, 1)
			value = minValue + (maxValue - minValue) * percent
			updateSlider()
			callback(value)

			isDragging = true
		end
	end)

	sliderFrame.InputEnded:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.Touch or 
			input.UserInputType == Enum.UserInputType.MouseButton1) and isDragging then

			-- Re-enable container scrolling
			tabContainer.ScrollingEnabled = true
			tabContainer.ScrollBarThickness = originalScrollBarThickness

			isDragging = false
			touchStartPosition = nil
		end
	end)

	game:GetService("UserInputService").InputChanged:Connect(function(input)
		if isDragging and (input.UserInputType == Enum.UserInputType.Touch or 
			input.UserInputType == Enum.UserInputType.MouseMovement) then

			-- Update slider value based on current position
			local mousePosition = input.Position.X
			local trackPosition = sliderTrack.AbsolutePosition.X
			local trackSize = sliderTrack.AbsoluteSize.X
			local percent = math.clamp((mousePosition - trackPosition) / trackSize, 0, 1)
			value = minValue + (maxValue - minValue) * percent
			updateSlider()
			callback(value)
		end
	end)

	-- Hover effects (mouse only)
	sliderFrame.MouseEnter:Connect(function()
		game:GetService("TweenService"):Create(sliderFrame, TweenInfo.new(0.2), { Transparency = 0 }):Play()
	end)

	sliderFrame.MouseLeave:Connect(function()
		game:GetService("TweenService"):Create(sliderFrame, TweenInfo.new(0.2), { Transparency = 0.4 }):Play()
	end)

	-- Add description if provided
	if description then
		local descLabel = Instance.new("TextLabel")
		descLabel.Parent = tabContainer
		descLabel.BackgroundTransparency = 1
		descLabel.Size = UDim2.new(1, 0, 0, 15)
		descLabel.Position = UDim2.new(0, 5, 0, 45)
		descLabel.Font = Enum.Font.Gotham
		descLabel.Text = description
		descLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		descLabel.TextSize = 12
		descLabel.TextXAlignment = Enum.TextXAlignment.Left
	end

	return sliderFrame
end

