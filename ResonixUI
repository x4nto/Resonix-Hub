function Library:CreateWindow(title, assetId)
	-- Create the main ScreenGui
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "ResonixHub"
	screenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	-- Create the main window frame
	local ResonixWindow = Instance.new("Frame")
	ResonixWindow.Name = "ResonixWindow"
	ResonixWindow.Parent = screenGui
	ResonixWindow.BackgroundColor3 = Color3.fromRGB(36, 16, 16)
	ResonixWindow.BorderSizePixel = 0
	ResonixWindow.Position = UDim2.new(0.336, 0, 0.326, 0)
	ResonixWindow.Size = UDim2.new(0, 363, 0, 220)
	ResonixWindow.Active = true
	ResonixWindow.Selectable = true

	-- Add rounded corners to the main window
	local windowCorner = Instance.new("UICorner")
	windowCorner.CornerRadius = UDim.new(0, 8)
	windowCorner.Parent = ResonixWindow

	-- Create the top bar
	local TopWindow = Instance.new("Frame")
	TopWindow.Name = "TopWindow"
	TopWindow.Parent = ResonixWindow
	TopWindow.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
	TopWindow.BorderSizePixel = 0
	TopWindow.Size = UDim2.new(1, 0, 0, 34)
	TopWindow.Active = true
	TopWindow.Selectable = true

	-- Add rounded corners to the top bar
	local topBarCorner = Instance.new("UICorner")
	topBarCorner.CornerRadius = UDim.new(0, 8)
	topBarCorner.Parent = TopWindow

	-- Make the window draggable only when holding mouse button (like original Roblox UI)
	local dragStartPos
	local windowStartPos
	local isDragging = false

	local function updateDrag(input)
		if not isDragging then return end

		local delta = input.Position - dragStartPos
		ResonixWindow.Position = UDim2.new(
			windowStartPos.X.Scale, 
			windowStartPos.X.Offset + delta.X,
			windowStartPos.Y.Scale, 
			windowStartPos.Y.Offset + delta.Y
		)
	end

	TopWindow.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			isDragging = true
			dragStartPos = input.Position
			windowStartPos = ResonixWindow.Position

			-- Change cursor to show dragging
			ResonixWindow.Input.MouseIcon = "rbxasset://SystemCursors/SizeAll"

			-- Capture the input to prevent camera movement
			input:Capture()
		end
	end)

	TopWindow.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			isDragging = false
			ResonixWindow.Input.MouseIcon = ""
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			updateDrag(input)
		end
	end)

	-- Mobile touch handling (prevents camera movement while dragging)
	local touchStartPos
	local touchStartTime
	local isTouchDragging = false

	TopWindow.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			touchStartPos = input.Position
			windowStartPos = ResonixWindow.Position
			touchStartTime = tick()
		end
	end)

	TopWindow.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			local currentPos = input.Position
			local delta = currentPos - touchStartPos

			-- Only start dragging after a small movement threshold to prevent accidental drags
			if delta.magnitude > 5 then
				isTouchDragging = true
				ResonixWindow.Position = UDim2.new(
					windowStartPos.X.Scale, 
					windowStartPos.X.Offset + delta.X,
					windowStartPos.Y.Scale, 
					windowStartPos.Y.Offset + delta.Y
				)
				input:Capture()
			end
		end
	end)

	TopWindow.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			isTouchDragging = false
		end
	end)

	-- Add the title label
	local TextLabel = Instance.new("TextLabel")
	TextLabel.Parent = TopWindow
	TextLabel.BackgroundTransparency = 1
	TextLabel.Position = UDim2.new(0.11, 0, 0, 0) -- Changed Y position to 0
	TextLabel.Size = UDim2.new(0.7, 0, 1, 0) -- Takes up 70% of width
	TextLabel.Font = Enum.Font.GothamBold
	TextLabel.Text = title
	TextLabel.TextColor3 = Color3.fromRGB(255, 0, 4)
	TextLabel.TextSize = 14
	TextLabel.TextXAlignment = Enum.TextXAlignment.Left -- Left aligned text
	TextLabel.TextTruncate = Enum.TextTruncate.AtEnd -- Truncate with ... if too long
	TextLabel.ClipsDescendants = true

	-- Add the icon
	local ImageLabel = Instance.new("ImageLabel")
	ImageLabel.Parent = TopWindow
	ImageLabel.BackgroundTransparency = 1
	ImageLabel.Position = UDim2.new(0.017, 0, 0.04, 0)
	ImageLabel.Size = UDim2.new(0, 31, 0, 31)
	ImageLabel.Image = "rbxassetid://132356790048396"

	-- [Rest of your window creation code remains the same...]
	-- Add a thicker horizontal line below the top bar
