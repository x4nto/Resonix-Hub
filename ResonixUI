	-- Add a UICorner to the button
	local UICorner = Instance.new("UICorner")
	UICorner.Parent = button

	-- Create a TextLabel inside the button for better text control
	local buttonText = Instance.new("TextLabel")
	buttonText.Parent = button
	buttonText.BackgroundTransparency = 1 -- Make the background transparent
	buttonText.Size = UDim2.new(1, -10, 1, -10) -- Slightly smaller than the button to add padding
	buttonText.Position = UDim2.new(0, 5, 0, 5) -- Move text 10 pixels from the left
	buttonText.Font = Enum.Font.GothamBold
