function Library:CreateTab(tabName)
	-- Create the tab button
	local tabButton = Instance.new("TextButton")
	tabButton.Parent = self.ScrollingFrame
	tabButton.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
	tabButton.BorderSizePixel = 2
	tabButton.BorderColor3 = Color3.fromRGB(94, 0, 2)
	tabButton.Size = UDim2.new(0, 104, 0, 23)
	tabButton.Font = Enum.Font.GothamBold
	tabButton.Text = tabName
	tabButton.TextColor3 = Color3.fromRGB(255, 0, 4)
	tabButton.TextSize = 14
	tabButton.AutoButtonColor = false -- Disable default button behavior

	-- Add a UICorner to the tab button
	local UICorner = Instance.new("UICorner")
	UICorner.Parent = tabButton

	-- Create the tab container
	local tabContainer = Instance.new("ScrollingFrame")
	tabContainer.Name = tabName .. "Container"
	tabContainer.Parent = self.AllFrame
	tabContainer.BackgroundColor3 = Color3.fromRGB(36, 16, 16)
	tabContainer.BorderSizePixel = 0
	tabContainer.Position = UDim2.new(0.05, 0, 0.05, 0)
	tabContainer.Size = UDim2.new(0.9, 0, 0.94, 0)
	tabContainer.Visible = false
	tabContainer.ScrollBarThickness = 2 -- Set the scrollbar thickness
	tabContainer.CanvasSize = UDim2.new(0, 0, 0, 0) -- Initialize canvas size

	-- Add a UIListLayout to the ScrollingFrame
	local layout = Instance.new("UIListLayout")
	layout.Parent = tabContainer
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 5)

	-- Update the ScrollingFrame's canvas size dynamically
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		tabContainer.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
	end)

	-- Touch handling variables
	local touchStartTime = 0
	local touchStartPos = nil
	local isTouchActive = false
	local maxTapDuration = 0.3 -- Maximum time for a tap (seconds)
	local maxTapMovement = 10 -- Maximum movement allowed for a tap (pixels)

	-- Button press visual effect
	local function setPressedState(pressed)
		game:GetService("TweenService"):Create(
			tabButton,
			TweenInfo.new(0.1),
			{
				BackgroundColor3 = pressed and Color3.fromRGB(50, 0, 0) or Color3.fromRGB(25, 0, 0)
			}
		):Play()
	end

	-- Function to switch to this tab
	local function switchToTab()
		-- Hide all other tab containers
		for _, child in pairs(self.AllFrame:GetChildren()) do
			if child:IsA("ScrollingFrame") then
				child.Visible = false
			end
		end
		-- Show the selected tab container
		tabContainer.Visible = true
	end

	-- Handle input for both mobile and desktop
	tabButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			-- Mobile touch handling
			touchStartTime = tick()
			touchStartPos = input.Position
			isTouchActive = true
			setPressedState(true)
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			-- Desktop mouse handling
			setPressedState(true)
		end
	end)

	tabButton.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			-- Mobile touch release
			if isTouchActive then
				local touchDuration = tick() - touchStartTime
				local endPos = input.Position
				local movement = touchStartPos and (endPos - touchStartPos).magnitude or 0

				-- Only switch tabs if it was a quick tap with minimal movement
				if touchDuration <= maxTapDuration and movement <= maxTapMovement then
					switchToTab()
				end

				setPressedState(false)
				isTouchActive = false
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			-- Desktop mouse release
			setPressedState(false)
			switchToTab()
		end
	end)

	-- Handle touch cancellation (like when scrolling starts)
	tabButton.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch and isTouchActive then
			local currentPos = input.Position
			local movement = touchStartPos and (currentPos - touchStartPos).magnitude or 0

			-- If movement exceeds threshold, cancel the touch
			if movement > maxTapMovement then
				setPressedState(false)
				isTouchActive = false
			end
		end
	end)

	-- Update the scrolling frame's canvas size
	self.ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, self.ScrollingFrame.UIListLayout.AbsoluteContentSize.Y)

	return tabContainer -- Return the ScrollingFrame
end

function Library:CreateButton(tabContainer, buttonName, callback, description)
	-- Create the button
	local button = Instance.new("TextButton")
	button.Parent = tabContainer
	button.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
	button.BorderSizePixel = 0
	button.Size = UDim2.new(1, 0, 0, 28)
	button.Text = ""
	button.AutoButtonColor = false

	-- Add UICorner
	local UICorner = Instance.new("UICorner")
	UICorner.Parent = button

	-- Create button text
	local buttonText = Instance.new("TextLabel")
	buttonText.Parent = button
	buttonText.BackgroundTransparency = 1
	buttonText.Size = UDim2.new(1, -10, 1, -10)
	buttonText.Position = UDim2.new(0, 5, 0, 5)
	buttonText.Font = Enum.Font.GothamBold
	buttonText.Text = buttonName
	buttonText.TextColor3 = Color3.fromRGB(255, 0, 4)
	buttonText.TextSize = 14
	buttonText.TextXAlignment = Enum.TextXAlignment.Left

	-- Touch handling variables
	local touchStartTime = 0
	local touchStartPos = nil
	local isTouchActive = false
	local maxTapDuration = 0.3
	local maxTapMovement = 10
	local isScrolling = false
	local isProcessing = false

	-- Button press visual effect
	local function setPressedState(pressed)
		if isProcessing then
			pressed = false -- Force released state if processing
		end
		game:GetService("TweenService"):Create(
			button,
			TweenInfo.new(0.1),
			{
				BackgroundColor3 = pressed and Color3.fromRGB(50, 0, 0) or Color3.fromRGB(25, 0, 0)
			}
		):Play()
	end

	-- Function to handle button press and release
	local function handleButtonAction()
		if isProcessing then return end -- Don't allow multiple clicks while processing

		isProcessing = true
		setPressedState(false) -- Immediately release the button

		-- Run the callback in a protected call
		local success, err = pcall(callback)
		if not success then
			warn("Button callback error:", err)
		end

		isProcessing = false
	end

	-- Input handling
	button.InputBegan:Connect(function(input)
		if isProcessing then return end

		if input.UserInputType == Enum.UserInputType.Touch then
			touchStartTime = tick()
			touchStartPos = input.Position
			isTouchActive = true
			isScrolling = false
			setPressedState(true)
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			setPressedState(true)
		end
	end)

	button.InputChanged:Connect(function(input)
		if isTouchActive and input.UserInputType == Enum.UserInputType.Touch then
			local currentPos = input.Position
			local movement = (currentPos - touchStartPos).magnitude

			if movement > maxTapMovement then
				isScrolling = true
				setPressedState(false)
			end
		end
	end)

	button.InputEnded:Connect(function(input)
		if isProcessing then return end

		if input.UserInputType == Enum.UserInputType.Touch and isTouchActive then
			local touchDuration = tick() - touchStartTime
			local endPos = input.Position
			local movement = (endPos - touchStartPos).magnitude

			if not isScrolling and touchDuration <= maxTapDuration and movement <= maxTapMovement then
				handleButtonAction()
			end

			setPressedState(false)
			isTouchActive = false
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			handleButtonAction()
			setPressedState(false)
		end
	end)

	-- Ensure button is released if touch is lost (e.g., finger leaves screen)
	UserInputService.TouchEnded:Connect(function(input, processed)
		if not processed and isTouchActive then
			setPressedState(false)
			isTouchActive = false
		end
	end)

	-- Add description if provided
	if description then
		local descLabel = Instance.new("TextLabel")
		descLabel.Parent = tabContainer
		descLabel.BackgroundTransparency = 1
		descLabel.Size = UDim2.new(1, 0, 0, 15)
		descLabel.Position = UDim2.new(0, 5, 0, 30)
		descLabel.Font = Enum.Font.Gotham
		descLabel.Text = description
		descLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		descLabel.TextSize = 12
		descLabel.TextXAlignment = Enum.TextXAlignment.Left
	end
end

