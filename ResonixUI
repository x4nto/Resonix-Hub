function Library:CreateOneTimeButton(tabContainer, buttonName, callback, description)
    -- Create the button
    local button = Instance.new("TextButton")
    button.Parent = tabContainer
    button.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
    button.BorderSizePixel = 0
    button.Size = UDim2.new(1, 0, 0, 28)
    button.Text = ""
    button.AutoButtonColor = false

    -- Add UICorner
    local UICorner = Instance.new("UICorner")
    UICorner.Parent = button

    -- Create button text
    local buttonText = Instance.new("TextLabel")
    buttonText.Parent = button
    buttonText.BackgroundTransparency = 1
    buttonText.Size = UDim2.new(1, -10, 1, -10)
    buttonText.Position = UDim2.new(0, 5, 0, 5)
    buttonText.Font = Enum.Font.GothamBold
    buttonText.Text = buttonName
    buttonText.TextColor3 = Color3.fromRGB(255, 0, 4)
    buttonText.TextSize = 14
    buttonText.TextXAlignment = Enum.TextXAlignment.Left

    -- Track if button has been clicked
    local hasBeenClicked = false

    -- Touch handling variables
    local touchStartTime = 0
    local touchStartPos = nil
    local isTouchActive = false
    local maxTapDuration = 0.3
    local maxTapMovement = 10
    local isScrolling = false

    -- Button press visual effect
    local function setPressedState(pressed)
        if hasBeenClicked then return end -- Don't show pressed state if already clicked
        game:GetService("TweenService"):Create(
            button,
            TweenInfo.new(0.1),
            {
                BackgroundColor3 = pressed and Color3.fromRGB(50, 0, 0) or Color3.fromRGB(25, 0, 0)
            }
        ):Play()
    end

    -- Function to handle button action
    local function handleButtonAction()
        if hasBeenClicked then return end -- Don't allow multiple clicks
        
        hasBeenClicked = true
        
        -- Change button appearance to show it's been clicked
        buttonText.Text = buttonName .. " (Active)"
        game:GetService("TweenService"):Create(
            button,
            TweenInfo.new(0.2),
            {
                BackgroundColor3 = Color3.fromRGB(15, 0, 0)
            }
        ):Play()
        
        -- Disable the button
        button.Active = false
        
        -- Run the callback in a protected call
        local success, err = pcall(callback)
        if not success then
            warn("OneTimeButton callback error:", err)
        end
    end

    -- Input handling
    button.InputBegan:Connect(function(input)
        if hasBeenClicked then return end
        
        if input.UserInputType == Enum.UserInputType.Touch then
            touchStartTime = tick()
            touchStartPos = input.Position
            isTouchActive = true
            isScrolling = false
            setPressedState(true)
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            setPressedState(true)
        end
    end)

    button.InputChanged:Connect(function(input)
        if isTouchActive and input.UserInputType == Enum.UserInputType.Touch then
            local currentPos = input.Position
            local movement = touchStartPos and (currentPos - touchStartPos).magnitude or 0

            if movement > maxTapMovement then
                isScrolling = true
                setPressedState(false)
            end
        end
    end)

    button.InputEnded:Connect(function(input)
        if hasBeenClicked then return end
        
        if input.UserInputType == Enum.UserInputType.Touch and isTouchActive then
            local touchDuration = tick() - touchStartTime
            local endPos = input.Position
            local movement = touchStartPos and (endPos - touchStartPos).magnitude or 0

            if not isScrolling and touchDuration <= maxTapDuration and movement <= maxTapMovement then
                handleButtonAction()
            end

            setPressedState(false)
            isTouchActive = false
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            handleButtonAction()
            setPressedState(false)
        end
    end)

    -- Ensure button is released if touch is lost
    UserInputService.TouchEnded:Connect(function(input, processed)
        if not processed and isTouchActive then
            setPressedState(false)
            isTouchActive = false
        end
    end)

    -- Add description if provided
    if description then
        local descLabel = Instance.new("TextLabel")
        descLabel.Parent = tabContainer
        descLabel.BackgroundTransparency = 1
        descLabel.Size = UDim2.new(1, 0, 0, 15)
        descLabel.Position = UDim2.new(0, 5, 0, 30)
        descLabel.Font = Enum.Font.Gotham
        descLabel.Text = description
        descLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
        descLabel.TextSize = 12
        descLabel.TextXAlignment = Enum.TextXAlignment.Left
    end

    -- Return the button and a function to reset it if needed
    return {
        Reset = function()
            hasBeenClicked = false
            buttonText.Text = buttonName
            button.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
            button.Active = true
        end
    }
end

