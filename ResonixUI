function Library:CreateTab(tabName)
	-- Create the tab button
	local tabButton = Instance.new("TextButton")
	tabButton.Parent = self.ScrollingFrame
	tabButton.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
	tabButton.BorderSizePixel = 2
	tabButton.BorderColor3 = Color3.fromRGB(94, 0, 2)
	tabButton.Size = UDim2.new(0, 104, 0, 23)
	tabButton.Font = Enum.Font.GothamBold
	tabButton.Text = tabName
	tabButton.TextColor3 = Color3.fromRGB(255, 0, 4)
	tabButton.TextSize = 14

	-- Add a UICorner to the tab button
	local UICorner = Instance.new("UICorner")
	UICorner.Parent = tabButton

	-- Create the tab container
	local tabContainer = Instance.new("ScrollingFrame")
	tabContainer.Name = tabName .. "Container"
	tabContainer.Parent = self.AllFrame
	tabContainer.BackgroundColor3 = Color3.fromRGB(36, 16, 16)
	tabContainer.BorderSizePixel = 0
	tabContainer.Position = UDim2.new(0.05, 0, 0.05, 0)
	tabContainer.Size = UDim2.new(0.9, 0, 0.94, 0)
	tabContainer.Visible = false
	tabContainer.ScrollBarThickness = 2 -- Set the scrollbar thickness
	tabContainer.CanvasSize = UDim2.new(0, 0, 0, 0) -- Initialize canvas size

	-- Add a UIListLayout to the ScrollingFrame
	local layout = Instance.new("UIListLayout")
	layout.Parent = tabContainer
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 5)

	-- Update the ScrollingFrame's canvas size dynamically
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		tabContainer.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
	end)

	-- Tab button click functionality
	tabButton.MouseButton1Click:Connect(function()
		-- Hide all other tab containers
		for _, child in pairs(self.AllFrame:GetChildren()) do
			if child:IsA("ScrollingFrame") then
				child.Visible = false
			end
		end
		-- Show the selected tab container
		tabContainer.Visible = true
	end)

	-- Update the scrolling frame's canvas size
	self.ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, self.ScrollingFrame.UIListLayout.AbsoluteContentSize.Y)

	return tabContainer -- Return the ScrollingFrame
end

