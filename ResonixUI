function Library:CreateToggle(tabContainer, toggleName, defaultState, callback, description)
	-- Create the toggle frame
	local toggleFrame = Instance.new("Frame")
	toggleFrame.Parent = tabContainer
	toggleFrame.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
	toggleFrame.BorderSizePixel = 0
	toggleFrame.Size = UDim2.new(1, 0, 0, 28)

	-- Add a UICorner to the toggle frame
	local UICorner = Instance.new("UICorner")
	UICorner.Parent = toggleFrame

	-- Create the toggle label
	local toggleLabel = Instance.new("TextLabel")
	toggleLabel.Parent = toggleFrame
	toggleLabel.BackgroundTransparency = 1
	toggleLabel.Size = UDim2.new(0.7, 0, 1, 0) -- 70% width for the label
	toggleLabel.Position = UDim2.new(0, 5, 0, 0)
	toggleLabel.Font = Enum.Font.GothamBold
	toggleLabel.Text = toggleName
	toggleLabel.TextColor3 = Color3.fromRGB(255, 0, 4)
	toggleLabel.TextSize = 14
	toggleLabel.TextXAlignment = Enum.TextXAlignment.Left

	-- Create the switch track
	local switchTrack = Instance.new("Frame")
	switchTrack.Parent = toggleFrame
	switchTrack.BackgroundColor3 = Color3.fromRGB(64, 64, 64) -- Gray background
	switchTrack.BorderSizePixel = 0
	switchTrack.Size = UDim2.new(0, 40, 0, 16) -- Smaller size
	switchTrack.Position = UDim2.new(0.9, -15, 0.8, -10) -- Positioned further to the right and lower
	switchTrack.AnchorPoint = Vector2.new(0.5, 0.5) -- Center the switch track

	-- Add a UICorner to the switch track
	local switchTrackCorner = Instance.new("UICorner")
	switchTrackCorner.Parent = switchTrack
	switchTrackCorner.CornerRadius = UDim.new(1, 0) -- Fully rounded corners

	-- Create the switch button
	local switchButton = Instance.new("Frame")
	switchButton.Parent = switchTrack
	switchButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- White button
	switchButton.BorderSizePixel = 0
	switchButton.Size = UDim2.new(0, 14, 0, 14) -- Smaller size
	switchButton.Position = UDim2.new(0, 1, 0.5, -7) -- Start on the left, slightly lower
	switchButton.AnchorPoint = Vector2.new(0, -4) -- Center vertically

	-- Add a UICorner to the switch button
	local switchButtonCorner = Instance.new("UICorner")
	switchButtonCorner.Parent = switchButton
	switchButtonCorner.CornerRadius = UDim.new(1, 0) -- Fully rounded corners

	-- Set the initial state of the toggle
	local isToggled = defaultState or false

	-- Function to update the toggle state with animation
	local function updateToggleState()
		local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

		-- Animate the switch button's position
		local tween = game:GetService("TweenService"):Create(
			switchButton,
			tweenInfo,
			{
				Position = isToggled and UDim2.new(1, -15, 0.5, -7) or UDim2.new(0, 1, 0.5, -7) -- Move right or left
			}
		)
		tween:Play()

		-- Animate the switch track's background color
		local colorTween = game:GetService("TweenService"):Create(
			switchTrack,
			tweenInfo,
			{
				BackgroundColor3 = isToggled and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(64, 64, 64) -- Green or gray
			}
		)
		colorTween:Play()
	end

	-- Set the initial state
	updateToggleState()

	-- Make the entire toggle frame clickable
	toggleFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isToggled = not isToggled
			updateToggleState()
			callback(isToggled)
		end
	end)

	-- Add description if provided
	if description then
		local descLabel = Instance.new("TextLabel")
		descLabel.Parent = tabContainer
		descLabel.BackgroundTransparency = 1
		descLabel.Size = UDim2.new(1, 0, 0, 15) -- Adjust height as needed
		descLabel.Position = UDim2.new(0, 5, 0, 30) -- Position below the toggle
		descLabel.Font = Enum.Font.Gotham
		descLabel.Text = description
		descLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		descLabel.TextSize = 12
		descLabel.TextXAlignment = Enum.TextXAlignment.Left
	end
end

function Library:CreateSlider(tabContainer, sliderName, minValue, maxValue, defaultValue, callback, description)
	-- Create the slider frame
	local sliderFrame = Instance.new("Frame")
	sliderFrame.Parent = tabContainer
	sliderFrame.BackgroundColor3 = Color3.fromRGB(25, 0, 0)
	sliderFrame.BorderSizePixel = 0
	sliderFrame.Size = UDim2.new(1, 0, 0, 40) -- Adjust height as needed

	-- Add a UICorner to the slider frame
	local UICorner = Instance.new("UICorner")
	UICorner.Parent = sliderFrame

	-- Create the slider label
	local sliderLabel = Instance.new("TextLabel")
	sliderLabel.Parent = sliderFrame
	sliderLabel.BackgroundTransparency = 1
	sliderLabel.Size = UDim2.new(0.3, 0, 0.5, 0) -- 30% width for the label
	sliderLabel.Position = UDim2.new(0, 5, 0, 0)
	sliderLabel.Font = Enum.Font.GothamBold
	sliderLabel.Text = sliderName
	sliderLabel.TextColor3 = Color3.fromRGB(255, 0, 4)
	sliderLabel.TextSize = 14
	sliderLabel.TextXAlignment = Enum.TextXAlignment.Left

	-- Create the slider track
	local sliderTrack = Instance.new("Frame")
	sliderTrack.Parent = sliderFrame
	sliderTrack.BackgroundColor3 = Color3.fromRGB(64, 64, 64) -- Gray background
	sliderTrack.BorderSizePixel = 0
	sliderTrack.Size = UDim2.new(1, -10, 0, 6) -- Longer track (60% width)
	sliderTrack.Position = UDim2.new(0.02, 0, 0.7, 0) -- Align with the text (30% from left)
	sliderTrack.AnchorPoint = Vector2.new(0, 0.5) -- Center the slider track

	-- Add a UICorner to the slider track
	local sliderTrackCorner = Instance.new("UICorner")
	sliderTrackCorner.Parent = sliderTrack
	sliderTrackCorner.CornerRadius = UDim.new(1, 0) -- Fully rounded corners

	-- Create the fill frame (represents the slider's progress)
	local fillFrame = Instance.new("Frame")
	fillFrame.Parent = sliderTrack
	fillFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 4) -- Red fill color
	fillFrame.BorderSizePixel = 0
	fillFrame.Size = UDim2.new(0, 0, 1, 0) -- Start with 0 width
	fillFrame.AnchorPoint = Vector2.new(0, 0) -- Center vertically

	-- Add a UICorner to the fill frame
	local fillCorner = Instance.new("UICorner")
	fillCorner.Parent = fillFrame
	fillCorner.CornerRadius = UDim.new(1, 0) -- Fully rounded corners

	-- Create the value label (number on the right side)
	local valueLabel = Instance.new("TextLabel")
	valueLabel.Parent = sliderFrame
	valueLabel.BackgroundTransparency = 1
	valueLabel.Size = UDim2.new(0.1, 0, 0.5, 0) -- 10% width for the value
	valueLabel.Position = UDim2.new(0.85, 0, 0, 0) -- Positioned in the right corner
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.Text = tostring(defaultValue)
	valueLabel.TextColor3 = Color3.fromRGB(255, 0, 4)
	valueLabel.TextSize = 14
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right -- Align text to the right

	-- Initialize the slider value
	local value = math.clamp(defaultValue or minValue, minValue, maxValue)
	local function updateSlider()
		local percent = (value - minValue) / (maxValue - minValue)
		fillFrame.Size = UDim2.new(percent, 0, 1, 0) -- Update the fill frame's width
		valueLabel.Text = tostring(math.floor(value)) -- Update the value label
	end

	-- Set the initial value
	updateSlider()

	-- Make the slider draggable
	local isDragging = false
	local userInputService = game:GetService("UserInputService")

	sliderTrack.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = true
			-- Update the slider immediately when clicked
			local mousePosition = input.Position.X
			local trackPosition = sliderTrack.AbsolutePosition.X
			local trackSize = sliderTrack.AbsoluteSize.X
			local percent = math.clamp((mousePosition - trackPosition) / trackSize, 0, 1)
			value = minValue + (maxValue - minValue) * percent
			updateSlider()
			callback(value)
		end
	end)

	sliderTrack.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = false
		end
	end)

	userInputService.InputChanged:Connect(function(input)
		if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local mousePosition = input.Position.X
			local trackPosition = sliderTrack.AbsolutePosition.X
			local trackSize = sliderTrack.AbsoluteSize.X
			local percent = math.clamp((mousePosition - trackPosition) / trackSize, 0, 1)
			value = minValue + (maxValue - minValue) * percent
			updateSlider()
			callback(value)
		end
	end)

	-- Hover effects
	sliderFrame.MouseEnter:Connect(function()
		game:GetService("TweenService"):Create(sliderFrame, TweenInfo.new(0.2), { Transparency = 0 }):Play()
	end)

	sliderFrame.MouseLeave:Connect(function()
		game:GetService("TweenService"):Create(sliderFrame, TweenInfo.new(0.2), { Transparency = 0.4 }):Play()
	end)

	-- Add description if provided
	if description then
		local descLabel = Instance.new("TextLabel")
		descLabel.Parent = tabContainer
		descLabel.BackgroundTransparency = 1
		descLabel.Size = UDim2.new(1, 0, 0, 15) -- Adjust height as needed
		descLabel.Position = UDim2.new(0, 5, 0, 45) -- Position below the slider
		descLabel.Font = Enum.Font.Gotham
		descLabel.Text = description
		descLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		descLabel.TextSize = 12
		descLabel.TextXAlignment = Enum.TextXAlignment.Left
	end

	-- Return the slider frame for further customization if needed
	return sliderFrame
end

function Library:CreateLabel(tabContainer, labelText)
	-- Create the label frame
	local labelFrame = Instance.new("Frame")
	labelFrame.Parent = tabContainer
	labelFrame.BackgroundTransparency = 1 -- Make the background transparent
	labelFrame.Size = UDim2.new(1, 0, 0, 20) -- Adjust height as needed

	-- Create the text label
	local label = Instance.new("TextLabel")
	label.Parent = labelFrame
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, 0)
	label.Position = UDim2.new(0, 5, 0, 0) -- Add slight padding
	label.Font = Enum.Font.GothamBold
	label.Text = labelText
	label.TextColor3 = Color3.fromRGB(255, 0, 4)
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left -- Align text to the left
end

return Library
