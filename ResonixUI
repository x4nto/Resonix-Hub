	buttonText.TextColor3 = Color3.fromRGB(255, 0, 4)
	buttonText.TextSize = 14
	buttonText.TextXAlignment = Enum.TextXAlignment.Left -- Align text to the left

	-- Connect the button's click event to the callback
	button.MouseButton1Click:Connect(callback)

	-- Add description if provided
	if description then
		local descLabel = Instance.new("TextLabel")
		descLabel.Parent = tabContainer
		descLabel.BackgroundTransparency = 1
		descLabel.Size = UDim2.new(1, 0, 0, 15) -- Adjust height as needed
		descLabel.Position = UDim2.new(0, 5, 0, 30) -- Position below the button
